# .ilo.env — per-repo ILO configuration (2026-08-14 RKDS 展開時に配線)
ILO_REPO="Rintaro-Ko/md-viewer-desktop"
ILO_DEFAULT_BRANCH="main"
ILO_PROJECT_NAME="md-viewer-desktop"

# Worktree-isolated claude implementation (main checkout may hold WIP).
ILO_PHASE_IMPL="bash scripts/ilo-impl.sh"

ILO_NOTIFY_BACKEND="stdout"
